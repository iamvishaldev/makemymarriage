# Copy to .env.local for local development. Never commit real values.
# Where deployed (preview/production) values are stored is not yet decided — see
# docs/decisions/0005-secrets-management.md.

# Public base URL of the app; used for absolute links and page metadata.
APP_URL=http://localhost:3000

# One of: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
